# Create a Maps JavaScript API key at https://console.cloud.google.com/
# Enable: Maps JavaScript API, Directions API, Places API (optional)
VITE_GOOGLE_MAPS_API_KEY=your_key_here

# Optional Map ID for cloud-based map styling / advanced markers
VITE_GOOGLE_MAPS_MAP_ID=

# Suitable App (server-side only — never prefix with VITE_)
# Coordinate institution IDs and admin credentials with Suitable support:
# https://developer.suitable.co/
SUITABLE_API_ENV=app
SUITABLE_BASE_URL=https://app.suitable.co
SUITABLE_INSTITUTION_ID=
SUITABLE_CATALOG_ID=
SUITABLE_USERNAME=
SUITABLE_PASSWORD=
# Override if Suitable gives Claflin a custom events path
SUITABLE_EVENTS_PATH=
